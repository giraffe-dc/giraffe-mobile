{
    "expo":  {
                 "name":  "Жирафик",
                 "slug":  "giraffe-mobile",
                 "version":  "1.0.4",
                 "orientation":  "portrait",
                 "userInterfaceStyle":  "light",
                 "backgroundColor":  "#FFFDF9",
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.giraffe.mobile"
                         },
                 "android":  {
                                 "package":  "com.giraffe.mobile",
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#FBF7EE",
                                                      "foregroundImage":  "./assets/adaptive-icon.png"
                                                  },
                                 "versionCode":  5
                             },
                 "plugins":  [
                                 "expo-router",
                                 "expo-font",
                                 [
                                     "expo-notifications",
                                     {
                                         "icon":  "./assets/icon.png",
                                         "color":  "#1E5B3F"
                                     }
                                 ],
                                 [
                                     "expo-location",
                                     {
                                         "locationWhenInUsePermission":  "Жирафик використовує геолокацію для розрахунку вартості дороги до вашої адреси."
                                     }
                                 ],
                                 [
                                     "expo-calendar",
                                     {
                                         "calendarPermission":  "Жирафик додає дату свята у ваш календар."
                                     }
                                 ]
                             ],
                 "scheme":  "giraffe",
                 "web":  {
                             "bundler":  "metro",
                             "output":  "static",
                             "name":  "Жирафик",
                             "shortName":  "Жирафик",
                             "lang":  "uk",
                             "themeColor":  "#1E5B3F",
                             "backgroundColor":  "#FBF7EE",
                             "description":  "Каталог свят, розрахунок вартості, бронювання й контакти команди «Жирафик».",
                             "display":  "standalone",
                             "orientation":  "portrait",
                             "barStyle":  "default",
                             "favicon":  "./assets/favicon.png"
                         },
                 "icon":  "./assets/icon.png",
                 "splash":  {
                                "image":  "./assets/icon.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#FBF7EE"
                            }
             }
}